<?xml version="1.0" encoding="utf-8"?>
<!--
  Depuis Android 9 (API 28), le trafic HTTP en clair est refusé par défaut.

  On ne l'autorise que pour les hôtes de développement : 10.0.2.2 est la
  machine hôte vue depuis l'émulateur, localhost couvre le port-forwarding adb.
  La production reste en HTTPS — d'où un domain-config ciblé plutôt qu'un
  usesCleartextTraffic="true" global, qui ouvrirait aussi le trafic en prod.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
