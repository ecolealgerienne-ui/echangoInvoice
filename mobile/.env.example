# URL absolue de l'API. Obligatoirement absolue : la webview Capacitor est
# servie depuis https://localhost, une URL relative n'atteindrait pas le serveur.
#
#   dev navigateur   http://localhost:3000/api/v1
#   émulateur Android http://10.0.2.2:3000/api/v1
#   appareil physique http://<ip-de-la-machine>:3000/api/v1
#   production        https://api.echango.dz/api/v1
VITE_API_URL=http://localhost:3000/api/v1
