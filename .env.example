# Application
NODE_ENV=development
PORT=3000
# web (5173), mobile en dev navigateur (5174), webview Capacitor (https/capacitor://localhost)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://localhost,capacitor://localhost

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/echango_invoice

# JWT
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# Email
# Placeholder assumé jusqu'au passage en VPS (docs/REPRISE.md) : avec ces
# valeurs, aucun message ne part et l'API rend 503 email_send_failed.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=noreply@example.com
EMAIL_SMTP_PASSWORD=smtp-password

# Adresse publique de l'application — celle par laquelle un CLIENT atteint le
# QR de vérification imprimé sur ses factures. Distincte d'ALLOWED_ORIGINS, qui
# décrit les postes de travail. R028 : à renseigner aussi dans le .env réel.
APP_PUBLIC_URL=http://localhost:5173

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
