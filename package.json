{
  "name": "echango-invoice-api",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "mobile"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "migration:run": "typeorm migration:run -d dist/config/database.config.js",
    "migration:revert": "typeorm migration:revert -d dist/config/database.config.js",
    "migration:generate": "typeorm migration:generate -d dist/config/database.config.js",
    "dev": "npx concurrently --names API,CLIENT --prefix-colors blue,green \"npm run start:dev\" \"npm --prefix client run dev\"",
    "seed": "ts-node -r dotenv/config -r tsconfig-paths/register src/database/seeds/seed.ts",
    "seed:demo": "ts-node -r dotenv/config -r tsconfig-paths/register src/database/seeds/seed-demo.ts",
    "verify:securite": "node scripts/verifier-securite.js",
    "verify:conformite": "node scripts/verifier-conformite.js",
    "verify": "npm run verify:securite && npm run verify:conformite && npm run verify:tri && npm run verify:periodes && npm run verify:codes-barres && npm run verify:signature && npm run verify:echeances && npm run verify:gabarit-pdf",
    "verify:tri": "node scripts/verifier-tri.js",
    "verify:periodes": "node scripts/verifier-periodes.js",
    "verify:codes-barres": "node scripts/verifier-codes-barres.js",
    "verify:signature": "node scripts/verifier-signature.js",
    "verify:echeances": "node scripts/verifier-echeances.js",
    "verify:gabarit-pdf": "node scripts/verifier-gabarit-pdf.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^6.0.0",
    "bwip-js": "^4.11.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "fastify": "^5.0.0",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "puppeteer": "^25.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.23"
  },
  "overrides": {
    "js-yaml": "^4.1.0",
    "multer": "^2.2.0",
    "@fastify/static": "^9.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  }
}
